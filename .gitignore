node_modules

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build
# Gallery photos — uploaded to the server by FTP by hand, deliberately NOT
# in the repo: ~950 files and climbing, and git is the wrong place for them.
#
# The .gitkeep files ARE tracked (negated below), because git cannot store an
# empty directory — without them a fresh clone has no gallery folders at all
# and the build produces an empty gallery with no hint that anything is
# missing. Keeping the tree means the folder names stay documented in the
# repo, which is the only part of this worth versioning.
#
# ⚠️ The earlier version of this block matched "/img/gallery/…", which is
# anchored to the repo root and therefore matched nothing — the photos live
# under static/. Any pattern here must start with static/ or be unanchored.
static/img/gallery/**/*.jpg
static/img/gallery/**/*.jpeg
static/img/gallery/**/*.png
static/img/gallery/**/*.webp
!static/img/gallery/**/.gitkeep

# Playwright
/test-results
/playwright-report
/playwright/.cache
/.playwright-mcp

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Contact form SMTP credentials. Written by hand on the server at
# /httpdocs/api/contact.secret.php if mail() ever needs upgrading to
# authenticated SMTP; contact.php includes it only if present. The FTP
# deploy excludes it too, so a deploy cannot erase it.
static/api/contact.secret.php

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
